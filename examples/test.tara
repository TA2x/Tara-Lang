# Tara code

show("Hello Tara!")

func void HelloWorld() {
    show("Hello Wrold!")
}

func int add(x: int, y: int) {
    return x + y
}

make x = 10

if (x > 5) {
    show("x is big")
} else {
    show("x is small")
}

show("functions testing")

HelloWorld()
show(add(5, 10), "\n")

make i = 0
while (i < 3) {
    show(i)
    make i = i + 1
}

for (make j = 0; j < 5; j = j + 1) {
    show(j)
}

make total = (
    1 + 2 +
    3 + 4
)
show(total)

make hi = 2
show("Hi ", hi, " Welcome")