# Final Showcase - Tara-Lang Complete Feature Demo

# ==========================================
# TARA-LANG COMPREHENSIVE FEATURE SHOWCASE
# ==========================================

show("╔════════════════════════════════════════╗")
show("║    TARA-LANG FEATURE SHOWCASE v0.1    ║")
show("╚════════════════════════════════════════╝")

show("")
show("✓ Lexer: Complete tokenization")
show("✓ Parser: Full syntax analysis")
show("✓ Interpreter: Runtime execution")
show("✓ Comments: # line comments supported")
show("✓ No semicolons: Optional throughout")

show("")
show("════════ FEATURES DEMONSTRATED ════════")
show("")

# Feature 1: Variables
show("1. VARIABLES (make keyword)")
make name = "Tara"
make version = 0.1
make pi = 3.14159
show(name)
show(version)
show(pi)

# Feature 2: Data Types
show("")
show("2. DATA TYPES")
make an_int = 42
make a_float = 3.14
make a_string = "Hello"
make a_bool = true
show(an_int)
show(a_float)
show(a_string)
show(a_bool)

# Feature 3: Arithmetic
show("")
show("3. ARITHMETIC OPERATIONS")
make x = 10
make y = 3
show(x + y)
show(x - y)
show(x * y)
show(x / y)

# Feature 4: Comparisons
show("")
show("4. COMPARISON OPERATORS")
if (x > y) {
    show("10 > 3: true")
}
if (x == 10) {
    show("10 == 10: true")
}

# Feature 5: Conditionals
show("")
show("5. CONDITIONALS (if/else)")
make score = 85
if (score >= 90) {
    show("Grade: A")
} else {
    if (score >= 80) {
        show("Grade: B")
    } else {
        show("Grade: C")
    }
}

# Feature 6: While Loops
show("")
show("6. WHILE LOOPS (while)")
make count = 0
while (count < 3) {
    show(count)
    make count = count + 1
}

# Feature 7: For Loops
show("")
show("7. FOR LOOPS")
for (make i = 0; i < 3; i = i + 1) {
    show(i)
}

# Feature 8: Nested Structures
show("")
show("8. NESTED STRUCTURES")
for (make i = 1; i <= 2; i = i + 1) {
    make inner = i
    while (inner > 0) {
        show(inner)
        make inner = inner - 1
    }
}

# Feature 9: Boolean Logic
show("")
show("9. BOOLEAN LOGIC")
make flag1 = true
make flag2 = false
if (flag1) {
    show("Flag1 is true")
}
if (!flag2) {
