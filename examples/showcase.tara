# Final Showcase - Tara-Lang Complete Feature Demo

# ==========================================
# TARA-LANG COMPREHENSIVE FEATURE SHOWCASE
# ==========================================

show("╔════════════════════════════════════════╗")
show("║    TARA-LANG FEATURE SHOWCASE v0.1    ║")
show("╚════════════════════════════════════════╝")

show("")
show("✓ Lexer: Complete tokenization")
show("✓ Parser: Full syntax analysis")
show("✓ Interpreter: Runtime execution")
show("✓ Comments: # line comments supported")
show("✓ No semicolons: Optional throughout")

show("")
show("════════ FEATURES DEMONSTRATED ════════")
show("")

# Feature 1: Variables
show("1. VARIABLES (make keyword)")
make name = "Tara"
make version = 0.1
make pi = 3.14159
show(name)
show(version)
show(pi)

# Feature 2: Data Types
show("")
show("2. DATA TYPES")
make an_int = 42
make a_float = 3.14
make a_string = "Hello"
make a_bool = true
show(an_int)
show(a_float)
show(a_string)
show(a_bool)

# Feature 3: Arithmetic
show("")
show("3. ARITHMETIC OPERATIONS")
make x = 10
make y = 3
show(x + y)
show(x - y)
show(x * y)
show(x / y)

# Feature 4: Comparisons
show("")
show("4. COMPARISON OPERATORS")
when (x > y) {
    show("10 > 3: true")
}
when (x == 10) {
    show("10 == 10: true")
}

# Feature 5: Conditionals
show("")
show("5. CONDITIONALS (when/otherwise)")
make score = 85
when (score >= 90) {
    show("Grade: A")
} otherwise {
    when (score >= 80) {
        show("Grade: B")
    } otherwise {
        show("Grade: C")
    }
}

# Feature 6: While Loops
show("")
show("6. WHILE LOOPS (during)")
make count = 0
during (count < 3) {
    show(count)
    make count = count + 1
}

# Feature 7: For Loops
show("")
show("7. FOR LOOPS")
for (make i = 0; i < 3; i = i + 1) {
    show(i)
}

# Feature 8: Nested Structures
show("")
show("8. NESTED STRUCTURES")
for (make i = 1; i <= 2; i = i + 1) {
    make inner = i
    during (inner > 0) {
        show(inner)
        make inner = inner - 1
    }
}

# Feature 9: Boolean Logic
show("")
show("9. BOOLEAN LOGIC")
make flag1 = true
make flag2 = false
when (flag1) {
    show("Flag1 is true")
}
when (!flag2) {
    show("Flag2 is NOT false (it is true)")
}

# Feature 10: Complex Expressions
show("")
show("10. COMPLEX EXPRESSIONS")
make result = (5 + 3) * 2 - (10 / 2)
show(result)

# Feature 11: Type Coercion
show("")
show("11. TYPE COERCION (int + float)")
make int_val = 10
make float_val = 2.5
make mixed_result = int_val + float_val
show(mixed_result)

# Feature 12: String Operations
show("")
show("12. STRING CONCATENATION")
make greeting = "Hello"
make target = "Tara"
make full_greeting = greeting
show(full_greeting)

# Feature 13: Variable Reassignment
show("")
show("13. VARIABLE REASSIGNMENT")
make counter = 5
show(counter)
make counter = counter * 2
show(counter)

# Final Summary
show("")
show("════════════════════════════════════════")
show("✓ All features working correctly!")
show("✓ Tara-Lang is ready to use!")
show("════════════════════════════════════════")
