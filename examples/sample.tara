# Tara example program - no semicolons required!

make x = 10
make y = x + 5

show("Hello Tara!")
show(x + y)

if (x > 5) {
    show("x is big")
} else {
    show("x is small")
}

make i = 0
while (i < 3) {
    show(i)
    make i = i + 1
}

for (make j = 0; j < 5; j = j + 1) {
    show(j)
}

make total = (
    1 + 2 +
    3 + 4
)
show(total)

# Test with booleans
make is_true = true
make is_false = false
show(is_true)
show(is_false)
